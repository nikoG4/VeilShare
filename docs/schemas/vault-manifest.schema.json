{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vault Manifest Logical Schema",
  "type": "object",
  "required": [
    "version",
    "vaultId",
    "files"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "vaultId": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Opaque FileId"
      }
    },
    "folders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy": {
      "type": "object"
    }
  }
}
